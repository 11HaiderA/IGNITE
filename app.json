{
  "expo": {
    "name": "Match Sticks",
    "slug": "match-sticks",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.matchsticks.puzzle"
    },
    "android": {
      "package": "com.matchsticks.puzzle",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#202636",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "resizeMode": "contain"
        }
      ],
      "expo-video",
      "expo-asset",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8090216489030865~2763064514",
          "iosAppId": "ca-app-pub-8090216489030865~2763064514"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableProguardInReleaseBuilds": false,
            "proguardRules": "-keep class expo.modules.** { *; }\n-keep class com.google.android.gms.ads.** { *; }\n-keep class com.facebook.react.** { *; }",
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a",
              "x86_64"
            ]
          }
        }
      ]
    ],
    "owner": "haideralirajas-team",
    "extra": {
      "eas": {
        "projectId": "c19d3530-34e3-4d1a-b299-938511b0ad27"
      }
    }
  }
}
